# Copy to .env.local for local dev. Set the same values in Vercel → Project → Settings → Environment Variables.

# Supabase → Project Settings → API Keys → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase → Project Settings → API Keys → Publishable key (sb_publishable_…).
# Safe in the browser: Row Level Security decides what it can read. The legacy "anon" key also works.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase → Project Settings → API Keys → Secret key (sb_secret_…). SERVER ONLY: it bypasses RLS.
# Used by the deck to mix in titles your partner liked without sending their likes to your browser.
# The legacy "service_role" key also works.
SUPABASE_SECRET_KEY=

# TMDB → Settings → API → "API Read Access Token" (the long JWT, not the short API key). SERVER ONLY.
TMDB_ACCESS_TOKEN=

# Optional. Any long random string. When set, only Vercel Cron can call /api/keepalive (the daily ping
# that keeps a free Supabase project from pausing). Set it in Vercel only; Vercel sends it automatically.
CRON_SECRET=

# Optional: match notifications (web push). Without these the app works, just without the toggle.
# Generate a pair once with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# SERVER ONLY.
VAPID_PRIVATE_KEY=
# Optional contact for push services (https: URL or mailto:). Defaults to the site's own https address.
VAPID_SUBJECT=
